# Copy to .env.local, fill in actual values, and restart pnpm dev.
# Main process only. Never prefix secrets with VITE_ or MAIN_VITE_.
ARKIVE_AI_PROVIDER=openai-compatible
ARKIVE_AI_BASE_URL=https://api.openai.com/v1
ARKIVE_AI_MODEL=
ARKIVE_AI_API_KEY=

# Native Pi providers: openai / anthropic / google / ...
# Use the provider's exact model ID; leave BASE_URL empty for its official URL.
# Compatible gateways: keep provider=openai-compatible and fill BASE_URL
# with the API root (usually /v1), NOT /chat/completions.
